# --- Wajib -----------------------------------------------------------------
# Rahasia bersama untuk Vercel Cron, trigger manual, dan step berantai.
# Vercel Cron otomatis mengirim "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=
# Endpoint ingest krl-app dan tokennya (= SYNC_INGEST_TOKEN di backend krl-app).
INGEST_URL=https://api-krl.inovasionline.com/api/v1/ingest
INGEST_TOKEN=

# --- Apa yang di-sync --------------------------------------------------------
# Daftar stasiun dan on/off sync otomatis diambil dari setting admin krl-app
# (GET $INGEST_URL/config). Dua nilai ini hanya cadangan kalau endpoint itu belum ada/gagal.
# Kode stasiun, pisahkan dengan koma. Kosong = semua stasiun yang aktif di KCI (fg_enable).
KCI_SYNC_STATIONS=THB
# Sync otomatis lewat Vercel Cron (jadwal di vercel.json): true / false.
AUTO_SYNC=true
# stations, schedules, trains (trains selalu ikut schedules).
KCI_SYNC_TYPES=stations,schedules,trains

# --- Sumber KCI (default sama dengan krl-app) ------------------------------------
# KCI_STATIONS_API_URL=https://www.kci.id/api/krl/stations
# KCI_SCHEDULES_API_URL=https://www.kci.id/api/krl/schedules?stationid=THB&timefrom=00%3A00&timeto=23%3A59
# KCI_TRAIN_STOPS_API_URL=https://www.kci.id/api/krl/train-schedule?trainid=5701C
# KCI_STATIONS_API_TOKEN=
# KCI_SCHEDULES_API_TOKEN=
# KCI_TRAIN_STOPS_API_TOKEN=

# --- Perilaku HTTP (default sama dengan krl-app) -----------------------------------
# KCI_TIMEOUT=20
# KCI_REQUEST_DELAY_MS=1000
# KCI_TRAIN_STOPS_CONCURRENCY=2
# KCI_RATE_LIMIT_PAUSE_SECONDS=30
# KCI_IMPERSONATE=chrome

# --- Vercel --------------------------------------------------------------------
# Lama kerja per invocation sebelum lanjut ke invocation berikutnya (maxDuration = 300).
# SYNC_TIME_BUDGET_SECONDS=180
# URL publik deployment ini untuk step berantai. Default: https://$VERCEL_PROJECT_PRODUCTION_URL
# SELF_URL=
